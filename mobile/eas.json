{
  "cli": {
    "version": ">= 18.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_BACKEND_MODE": "mock",
        "EXPO_PUBLIC_ALLOW_MODE_SWITCH": "true",
        "EXPO_PUBLIC_APP_VERSION": "1.14.6"
      },
      "environment": "preview"
    },
    "apk-readonly": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_BACKEND_MODE": "live-readonly",
        "EXPO_PUBLIC_ALLOW_MODE_SWITCH": "false",
        "EXPO_PUBLIC_APP_VERSION": "1.14.6"
      },
      "environment": "preview"
    },
    "apk": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_BACKEND_MODE": "live",
        "EXPO_PUBLIC_ALLOW_MODE_SWITCH": "false",
        "EXPO_PUBLIC_APP_VERSION": "1.14.6"
      },
      "environment": "production"
    }
  }
}
