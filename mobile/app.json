{
  "expo": {
    "name": "Super 75",
    "slug": "ujjwal-pathak-mentorship",
    "version": "1.16.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "upmentorship",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F4F7FB"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ujjwalpathak.mentorship",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.ujjwalpathak.mentorship",
      "googleServicesFile": "./google-services.json",
      "versionCode": 50,
      "adaptiveIcon": {
        "backgroundColor": "#F9F5EF",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "softwareKeyboardLayoutMode": "pan",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "INTERNET",
        "POST_NOTIFICATIONS",
        "REQUEST_INSTALL_PACKAGES"
      ]
    },
    "plugins": [
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      "expo-document-picker",
      [
        "expo-notifications",
        {
          "color": "#3157D5",
          "defaultChannel": "ump-updates"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Super 75 by Ujjwal to use your location only for local weather and adaptive dashboard themes.",
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow recording only when you choose voice input for a study receipt.",
          "recordAudioAndroid": true,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ]
    ],
    "web": {
      "bundler": "metro"
    },
    "owner": "anujkarewad",
    "extra": {
      "eas": {
        "projectId": "fc2cb9eb-e3f0-40b2-9a74-7c996902602c"
      }
    }
  }
}
