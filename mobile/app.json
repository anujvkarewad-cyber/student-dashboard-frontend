{
  "expo": {
    "name": "Ujjwal Pathak Mentorship",
    "slug": "ujjwal-pathak-mentorship",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "upmentorship",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F4F7FB"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ujjwalpathak.mentorship",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.ujjwalpathak.mentorship",
      "versionCode": 3,
      "adaptiveIcon": {
        "backgroundColor": "#F9F5EF",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": true,
      "permissions": [
        "INTERNET"
      ]
    },
    "plugins": [
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      "expo-document-picker",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Ujjwal Pathak Mentorship to use your location only for local weather and adaptive dashboard themes.",
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ]
    ]
  }
}
