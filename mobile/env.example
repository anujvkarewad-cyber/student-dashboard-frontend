# Local development only. Production receives the Worker origin from an EAS
# environment variable; no retired-host fallback is compiled into the APK.
EXPO_PUBLIC_BACKEND_MODE=live
EXPO_PUBLIC_ALLOW_MODE_SWITCH=false
EXPO_PUBLIC_API_BASE_URL=https://upm-emergency-gateway.YOUR-SUBDOMAIN.workers.dev

# Optional analytics-sync secret. Prefer routing this server-side; never put a
# privileged backend credential in an EXPO_PUBLIC variable.
EXPO_PUBLIC_MENTOR_SYNC_SECRET=
EXPO_PUBLIC_APP_VERSION=1.14.4
